# ==========================================
# RAG Backend 环境变量配置
# Agent 层统一 PostgreSQL 版本
# ==========================================

# === LLM 配置 ===
RAGENT_LLM_PROVIDER=openai
RAGENT_LLM_MODEL=qwen3.5-omni-flash
RAGENT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=your-api-key-here

# === Embedding 配置 ===
# RAGENT_EMBEDDING_PROVIDER=openai
# RAGENT_EMBEDDING_MODEL=text-embedding-v3
# RAGENT_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# === Vision LLM 配置 ===
# RAGENT_VISION_LLM_ENABLED=true
# RAGENT_VISION_LLM_PROVIDER=openai
# RAGENT_VISION_LLM_MODEL=qwen3.5-omni-flash

# === Agent 层存储配置（PostgreSQL，必需）===
RAGENT_POSTGRES_URL=postgresql://user:password@localhost:5432/ragent

# === IG 层存储配置（SQLite，本地文件指纹）===
RAGENT_SQLITE_PATH=checkpoints.sqlite

# === 记忆管理配置 ===
RAGENT_MAX_MESSAGES=20
RAGENT_KEEP_RECENT=4

# === 服务器配置 ===
RAGENT_PORT=8000

# === 鉴权（必需）===
# JWT 签名密钥。这是整个系统身份校验的唯一凭据：拿到它就能伪造任意用户
# （包括 super_admin）的登录凭证，多租户权限隔离会完全失效。
# 未设置时服务会拒绝启动（除非 RAGENT_DEBUG=true 走本地开发的内置密钥）。
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
RAGENT_JWT_SECRET=change-me-to-a-random-secret
# 本地开发开关：允许 RAGENT_JWT_SECRET 缺省时使用内置密钥（resolve_jwt_secret）、
# CORS 未配置来源时回退到本地前端常见地址（resolve_cors_origins）、
# RAGENT_CONNECTOR_ENCRYPTION_KEY 缺省时使用内置密钥（resolve_connector_encryption_key）。
# 生产环境必须保持 false。2026-08-26 起不再对应任何绕过 ACL 的测试端点——
# 那组端点（连带这里原来的说明）已随 CLAUDE.md §5「已修复」整体删除。
RAGENT_DEBUG=false

# 租户连接器凭证（企业接入自己知识库/考勤系统用的 API token）加密密钥。
# 未设置时服务会拒绝启动（除非 RAGENT_DEBUG=true 走本地开发的内置密钥）。
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 存量明文数据的一次性迁移：scripts/migrate_connector_auth_config_encryption.py
# ⚠️ 丢失这个密钥后，已加密的连接器凭证将永久无法解密（对称加密的正常代价），
# 需要各企业管理员通过管理后台重新填一次 token。
RAGENT_CONNECTOR_ENCRYPTION_KEY=change-me-to-a-random-fernet-key

# CORS 允许的来源，逗号分隔，如 https://app.acme.com,https://admin.acme.com。
# 生产环境必须显式配置——未配置且 RAGENT_DEBUG!=true 时不允许任何跨域来源
# （浏览器请求会被 CORS 拦截，而不是像原来那样允许任意来源携带凭证访问）。
# 本地开发不配置也可以，RAGENT_DEBUG=true 时会自动回退到 Vite 默认地址。
# RAGENT_ALLOWED_ORIGINS=https://app.acme.com

# ── 结构化日志（可观测性阶段一）────────────────────────────────────
# 级别。
RAGENT_LOG_LEVEL=INFO
# json | text。json 是给机器聚合用的（一行一个对象，extra 字段平铺进顶层）；
# text 是人类可读，本地调试用。
RAGENT_LOG_FORMAT=json
# stdout | stderr | file | both。stdout 是 12-factor 的默认，容器/k8s 原生采集。
# ⚠️ MCP stdio 服务必须用 stderr——stdout 是 JSON-RPC 通信信道，
#    往里写一行日志就会破坏报文边界（src/mcp_server/server.py 会自动钉死这一条）。
RAGENT_LOG_DEST=stdout
# dest 含 file 时的落盘目录。按天轮转成 app.jsonl.YYYY-MM-DD。
RAGENT_LOG_DIR=logs/app
# 保留几天的轮转文件（D-3：应用日志 7 天；审计日志 180 天由 audit_logs 表另管）。
RAGENT_LOG_RETENTION_DAYS=7
# ⚠️ 默认 false：用户提问、模型回答、检索到的知识库原文这类 S2 内容字段
#    只记「长度 + sha256 前 12 位」，不落原文——日志本身就不再是泄露面，
#    内容的权威副本在 conversation_archive 表里。
#    排障期可临时置 true（开启时会打一条 warning 留痕），但**最终 prompt
#    在任何开关下都不记原文**（S2+，见 docs/observability_design.md §2.4）。
RAGENT_LOG_CONTENT=false

# ── BM25 索引存储（方案 C，见 docs/bm25_storage_design.md）────────────
# 摄入时是否同时写 SQLite 副本。默认开；失败不阻断摄入，但会打 ERROR。
RAGENT_BM25_SQLITE_DUAL_WRITE=true
# 读后端：auto | json | sqlite
#   auto   —— 副本存在、JSON 大于阈值、且副本不比 JSON 旧 → 走 SQLite，否则 JSON
#   json   —— 强制 JSON。**这是回滚开关**，检索出问题时不必改代码
#   sqlite —— 强制 SQLite，缺副本直接报错。仅供迁移验收，别在生产开
RAGENT_BM25_READ_BACKEND=auto
# ⚠️ 小索引上 SQLite 反而更慢（连接固定开销约 0.5ms > 60KB 的 json.load 0.35ms）。
#    实测交叉点约 50 块 / 290KB，所以 auto 模式下 JSON 小于这个字节数就继续走 JSON。
RAGENT_BM25_SQLITE_MIN_JSON_BYTES=262144

# ── 检索层迁移 OpenSearch（docs/opensearch_migration_design.md）─────────
RAGENT_OPENSEARCH_URL=http://localhost:9200
# 摄入时是否同时写 OpenSearch 副本。默认开；失败不阻断摄入，但打 ERROR。
RAGENT_OPENSEARCH_DUAL_WRITE=true
# 读后端灰度开关：不设/off（默认，全部走旧链路）| * （全切）| 逗号分隔的
# collection 白名单（只有列出的走 OpenSearch）。
# ⚠️ 白名单是**精确匹配**，不做前缀或通配 —— 模糊匹配写错一个字符就可能把
#    一批本不该切的库带进去，而症状（检索结果变了）不会立刻被发现。
# ⚠️ 这是**回滚开关**：检索出问题时改成 off 即可退回旧链路，不必回滚部署。
RAGENT_OPENSEARCH_READ=off
