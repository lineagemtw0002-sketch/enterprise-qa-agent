# --- LLM provider ---
# 可选：anthropic / openai / ollama
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# 本地模型（Ollama）时使用
OLLAMA_BASE_URL=http://localhost:11434

# --- Embedding ---
# 默认本地开源模型，无需 API key；可选 openai / voyage
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# --- Database ---
DATABASE_URL=postgresql+psycopg://eqa:eqa@localhost:5432/eqa
# Read-only role used by the agent's SQL tool (created by backend/db/initdb/02_readonly_role.sql)
DATABASE_URL_READONLY=postgresql+psycopg://eqa_readonly:eqa_readonly@localhost:5432/eqa

# --- Auth ---
JWT_SECRET=change-me-in-production

# --- CORS ---
# Comma-separated list of allowed frontend origins
FRONTEND_ORIGINS=http://localhost:5173
